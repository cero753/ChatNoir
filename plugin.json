{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "chatnoir",
  "version": "0.2.0",
  "description": "Protect what you build from agent attacks. Portable security review, attack-path analysis, and fix verification for coding agents.",
  "author": {"name": "Farouk Hajjej", "url": "https://github.com/fhajjej-ship-it"},
  "homepage": "https://github.com/fhajjej-ship-it/ChatNoir",
  "repository": "https://github.com/fhajjej-ship-it/ChatNoir",
  "license": "MIT",
  "keywords": ["security", "vulnerability", "agent-skills", "codex", "claude-code", "cursor"],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "ChatNoir",
        "shortDescription": "Protect what you build from agent attacks.",
        "developerName": "Farouk Hajjej",
        "category": "Developer Tools",
        "brandColor": "#111111",
        "logo": "./assets/logo.png",
        "composerIcon": "./assets/logo.png",
        "defaultPrompt": ["Use ChatNoir to review this project for security vulnerabilities."]
      }
    }
  }
}
